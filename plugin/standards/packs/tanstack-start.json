{
	"description": "The rules written for TanStack Start: the React and base rules, the framework's own files left to it, and the folders it adds for routes, server functions and queries.",
	"include": {
		"packs": ["lightsout/react", "lightsout/code-style"],
		"topics": [
			"lightsout/code/fractal/imports",
			"lightsout/code/fractal/duplication",
			"lightsout/code/frameworks/tanstack-start",
			"lightsout/tests/frameworks/tanstack-start"
		],
		"rules": [
			"lightsout/multi-export",
			"lightsout/filename-mismatch",
			"lightsout/case-collision",
			"lightsout/file-size",
			"lightsout/folder-size",
			"lightsout/test-beside-subject",
			"lightsout/test-support-in-src",
			"lightsout/test-file-size"
		]
	},
	"rule-settings": {
		"explicit-return-type": { "exclude": ["**/*.tsx", "**/use[A-Z]*.ts", "**/*QueryOptions.ts"] },
		"feature-folders": { "exclude": ["src/features/*/queries", "src/features/*/server"] },
		"shared-layer": { "exclude": ["src/routes", "src/server"] },
		"file-size": { "exclude": ["**/routeTree.gen.ts"] },
		"filename-mismatch": { "exclude": ["**/routes/**", "**/routeTree.gen.ts", "**/router.tsx", "**/client.tsx", "**/server.ts", "**/ssr.tsx", "**/start.ts"] },
		"multi-export": { "exclude": ["**/routes/**", "**/routeTree.gen.ts", "**/router.tsx", "**/client.tsx", "**/server.ts", "**/ssr.tsx", "**/start.ts"] },
		"named-string-values": { "exclude": ["**/routes/**", "**/routeTree.gen.ts"] }
	},
	"applies-when": { "dependencies": ["@tanstack/react-start"] }
}
