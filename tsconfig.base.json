{
	// Carries no `paths`, `include` or `exclude`: those are genuinely per-package.
	//
	// No `composite` and no project references: references require declaration emit, which
	// `allowImportingTsExtensions` cannot coexist with. That flag is load-bearing: an `imports`
	// target (`#src/*` -> `./src/*`) gets no extension probing from Node, TypeScript, esbuild, Vite
	// or Jest, and Node's type stripping needs the extension when the engine loads a rule's
	// check.ts from plugin/standards/ on a consumer's machine.
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"strict": true,
		"noEmit": true,
		"skipLibCheck": true,
		"isolatedModules": true,
		"forceConsistentCasingInFileNames": true,
		"allowImportingTsExtensions": true,
		"types": ["node"]
	}
}
