#!/bin/sh
#
# Refuse to push when plugin/ is not shippable.
#
# plugin/ is what users actually run — marketplace installs copy it and
# nothing else. Both halves are committed build outputs (plugin/dist/cli.mjs
# from packages/engine/src/, plugin/standards/ from
# packages/lightsout-standards/), and the version in
# plugin.json is how a user tells one build from another.
#
# What "shippable" means lives in scripts/checkShipped.mjs, not here. CI runs
# that same file, so this hook cannot quietly be more lenient than the gate
# that actually blocks a merge. This is the fast local answer; CI is the
# authority.
#
# The same two lines guard assets/default-pack.json, which is the authored
# standards pack the web app carries so a rule page can show its examples off
# this monorepo. scripts/buildDefaultPackView.mjs --check is what says whether
# it still matches packages/lightsout-standards/, and CI runs that file too.
#
# The version is compared against your local origin/main, which is only as
# fresh as your last fetch. A stale ref can miss a bump someone else already
# made — CI fetches first and gets the real answer.
#
# Enable once per clone:  git config core.hooksPath .githooks
# Bypass in an emergency: git push --no-verify

set -eu

# A branch deletion (`git push --delete`) pushes nothing to verify.
deleting=1
while read -r _local_ref local_sha _remote_ref _remote_sha; do
	[ "$local_sha" = "0000000000000000000000000000000000000000" ] || deleting=0
done
[ "$deleting" = 1 ] && exit 0

root=$(git rev-parse --show-toplevel)

# Nothing to check in a tree that predates the script.
[ -f "$root/scripts/checkShipped.mjs" ] || exit 0

if node "$root/scripts/checkShipped.mjs" && node "$root/scripts/buildDefaultPackView.mjs" --check; then
	exit 0
fi

cat >&2 <<'MSG'
  Fix it, add the rebuilt files to a commit, and push again.

  Note: this reads your working tree, so uncommitted edits trip it too.
  Bypass with 'git push --no-verify'.

MSG
exit 1
