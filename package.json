{
	"name": "lightsout",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"description": "Deterministic engine for coding agents — the accountability shell that lets the factory run with the lights off.",
	"license": "MIT",
	"author": "David Christian",
	"engines": {
		"node": ">=22.18.0"
	},
	"packageManager": "pnpm@10.20.0",
	"scripts": {
		"lint": "biome check --error-on-warnings .",
		"format": "biome check --write .",
		"typecheck": "nx run-many -t typecheck && tsc --noEmit",
		"check": "pnpm lint && pnpm typecheck && node scripts/buildWorkflowSpecs.mjs --check && node scripts/buildConfigKeyReference.mjs --check && node scripts/buildPluginPrompts.mjs --check && node scripts/checkEngineNamesNoStandards.mjs",
		"test": "pnpm test:unit && pnpm test:e2e",
		"test:unit": "nx run-many -t test:unit",
		"test:unit:coverage": "nx run-many -t test:unit:coverage",
		"test:e2e": "nx run-many -t test:e2e",
		"jest": "node --no-sparkplug tooling/jest/runJest.cjs",
		"bundle": "nx run-many -t bundle",
		"build": "pnpm bundle && nx build web-app",
		"build:web": "nx build web-app",
		"check:shipped": "node scripts/checkShipped.mjs",
		"build:default-pack": "node scripts/buildDefaultPackView.mjs",
		"check:default-pack": "node scripts/buildDefaultPackView.mjs --check",
		"build:workflow-specs": "node scripts/buildWorkflowSpecs.mjs",
		"compare:plan-drafts": "node scripts/comparePlanDrafts.mjs",
		"build:config-reference": "node scripts/buildConfigKeyReference.mjs",
		"build:plugin-prompts": "node scripts/buildPluginPrompts.mjs",
		"build:sprawl": "node scripts/buildSprawlDataset.mjs",
		"build:sprawl-gif": "node scripts/renderSprawlGif.mjs",
		"graph": "nx graph",
		"lightsout": "node plugin/dist/cli.mjs"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.7",
		"@jest/globals": "catalog:",
		"@resvg/resvg-js": "2.6.2",
		"@types/node": "catalog:",
		"esbuild": "catalog:",
		"gifenc": "1.0.3",
		"jest": "catalog:",
		"nx": "^23.1.1",
		"ts-jest": "catalog:",
		"typescript": "catalog:"
	}
}
