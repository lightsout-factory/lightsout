{
	"name": "@lightsout/engine",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"description": "The deterministic engine: gates, typed contracts, resumable manifests, supervisor.",
	"license": "MIT",
	"exports": {
		".": "./src/index.ts",
		"./contracts": "./src/contracts/index.ts",
		"./commands": "./src/commands/index.ts",
		"./cli": "./src/main.ts"
	},
	"imports": {
		"#src/*": "./src/*",
		"#tests/*": "./tests/*"
	},
	"dependencies": {
		"@jscpd/core": "catalog:",
		"@jscpd/tokenizer": "catalog:",
		"@lightsout/shared": "workspace:*",
		"@lightsout/standards-contracts": "workspace:*",
		"@linear/sdk": "catalog:",
		"picomatch": "catalog:",
		"tinyglobby": "catalog:",
		"yaml": "catalog:",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@jest/globals": "catalog:",
		"@types/node": "catalog:",
		"@types/picomatch": "catalog:",
		"typescript": "catalog:"
	},
	"scripts": {
		"typecheck": "tsc --noEmit",
		"check": "biome check --error-on-warnings . && tsc --noEmit",
		"test:unit": "node --no-sparkplug ../../tooling/jest/runJest.cjs -c jest.config.cjs",
		"test:unit:coverage": "node --no-sparkplug ../../tooling/jest/runJest.cjs -c jest.config.cjs --coverage",
		"test:e2e": "node --no-sparkplug ../../tooling/jest/runJest.cjs -c jest.e2e.config.cjs",
		"bundle": "node ../../scripts/buildEngine.mjs"
	},
	"nx": {
		"name": "engine",
		"targets": {
			"bundle": {
				"outputs": [
					"{workspaceRoot}/plugin/dist"
				]
			}
		}
	}
}
