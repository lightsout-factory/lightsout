{
	"extends": "../../tsconfig.base.json",
	"include": ["**/*.ts"],
	// A rule's fixtures are deliberately broken code — the fail side violates the
	// very rule it proves — so type-checking them would report a package's own
	// counter-examples as errors. node_modules is restated because naming
	// `exclude` at all replaces TypeScript's default.
	"exclude": ["node_modules", "**/fixtures/**"]
}
