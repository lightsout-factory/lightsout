{
	"name": "@lightsout/lightsout-standards",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"description": "The standards lightsout ships: the TypeScript rules its own agents write against.",
	"license": "MIT",
	"imports": {
		"#common/*": "./common/*"
	},
	"devDependencies": {
		"@jest/globals": "catalog:",
		"@lightsout/standards-contracts": "workspace:*",
		"@lightsout/standards-testkit": "workspace:*",
		"@types/node": "catalog:",
		"typescript": "catalog:",
		"zod": "catalog:"
	},
	"scripts": {
		"typecheck": "tsc --noEmit",
		"check": "biome check --error-on-warnings . && tsc --noEmit",
		"test:unit": "node --no-sparkplug ../../tooling/jest/runJest.cjs -c jest.config.cjs",
		"bundle": "node ../../scripts/copyStandards.mjs",
		"test:unit:coverage": "node --no-sparkplug ../../tooling/jest/runJest.cjs -c jest.config.cjs --coverage"
	},
	"nx": {
		"name": "lightsout-standards",
		"targets": {
			"bundle": {
				"outputs": [
					"{workspaceRoot}/plugin/standards"
				]
			}
		}
	}
}
