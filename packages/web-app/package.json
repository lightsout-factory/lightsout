{
	"name": "@lightsout/web-app",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"description": "Local viewer for lightsout runs and the standards check.",
	"license": "MIT",
	"imports": {
		"#src/*": "./src/*",
		"#tests/*": "./tests/*"
	},
	"nx": {
		"name": "web-app"
	},
	"scripts": {
		"start:dev": "vite dev",
		"build": "vite build",
		"start:prod": "srvx --prod -s dist/client dist/server/server.js",
		"typecheck": "tsc --noEmit",
		"check": "biome check --error-on-warnings . && tsc --noEmit",
		"test:unit": "node --no-sparkplug ../../tooling/jest/runJest.cjs -c jest.config.cjs",
		"test:unit:coverage": "node --no-sparkplug ../../tooling/jest/runJest.cjs -c jest.config.cjs --coverage"
	},
	"dependencies": {
		"@fontsource/be-vietnam-pro": "5.2.8",
		"@fontsource/jetbrains-mono": "5.3.0",
		"@fontsource/plus-jakarta-sans": "5.2.8",
		"@lightsout/engine": "workspace:*",
		"@lightsout/shared": "workspace:*",
		"@radix-ui/react-checkbox": "1.3.11",
		"@radix-ui/react-dialog": "1.1.15",
		"@radix-ui/react-popover": "1.1.23",
		"@radix-ui/react-slot": "1.2.4",
		"@radix-ui/react-tabs": "1.1.21",
		"@tanstack/react-query": "5.95.2",
		"@tanstack/react-router": "1.168.3",
		"@tanstack/react-router-with-query": "1.130.17",
		"@tanstack/react-start": "1.167.5",
		"class-variance-authority": "0.7.1",
		"clsx": "2.1.1",
		"date-fns": "4.1.0",
		"lucide-react": "1.0.1",
		"prism-react-renderer": "2.4.1",
		"react": "19.2.4",
		"react-dom": "19.2.4",
		"react-markdown": "10.1.0",
		"remark-gfm": "4.0.1",
		"tailwind-merge": "3.5.0",
		"tw-animate-css": "1.4.0",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@jest/globals": "catalog:",
		"@netlify/vite-plugin-tanstack-start": "1.3.19",
		"@tailwindcss/vite": "4.2.2",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/react": "^16.3.0",
		"@types/node": "catalog:",
		"@types/react": "19.2.14",
		"@types/react-dom": "19.2.3",
		"@vitejs/plugin-react": "6.0.1",
		"jest": "catalog:",
		"jest-environment-jsdom": "^30.4.1",
		"srvx": "^0.11.13",
		"tailwindcss": "4.2.2",
		"ts-jest": "catalog:",
		"typescript": "catalog:",
		"vite": "8.0.2"
	}
}
